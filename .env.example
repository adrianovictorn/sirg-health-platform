# Banco de Dados
DB_NAME=sirg_db
DB_USER=sirg_user
DB_PASSWORD=troque_esta_senha

# JWT — use uma string longa e aleatória (mínimo 32 chars)
JWT_SECRET=gere_uma_chave_forte_aqui_com_32_caracteres_ou_mais

# RabbitMQ
RABBITMQ_USER=sirg_rabbit
RABBITMQ_PASSWORD=troque_esta_senha_rabbit

# Identidade do município nesta instância
MUNICIPIO_NOME=NOME_DO_MUNICIPIO
MUNICIPIO_QUEUE=fila_nome_do_municipio

# URL pública da aplicação (sem barra no final)
# Usado pelo SvelteKit (ORIGIN) e como origem CORS permitida no backend
APP_ORIGIN=http://SEU_IP_OU_DOMINIO
