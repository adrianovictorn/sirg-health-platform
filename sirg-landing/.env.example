# Landing pública do SIRG — copie para .env e ajuste.

# Endereço público da própria landing (canonical, sitemap, Open Graph).
PUBLIC_SITE_URL=http://localhost:5174

# false = <meta robots noindex> + robots.txt "Disallow: /".
# Só mude para true depois de revisar o histórico (src/lib/conteudo/historico.js).
PUBLIC_INDEXAVEL=false

# Instâncias do SIRG. *_API é de onde o SERVIDOR da landing lê
# GET /api/transparencia/resumo (nunca vai para o navegador);
# *_ACESSO é para onde o botão "Acessar" leva o visitante;
# *_MUNICIPIO é o identificador que a instância devolve (MUNICIPIO_NOME dela).
SIRG_SAOFELIPE_API=https://sirgsaofelipe.com
SIRG_SAOFELIPE_ACESSO=https://sirgsaofelipe.com/login
SIRG_SAOFELIPE_MUNICIPIO=SAO_FELIPE

SIRG_CONCEICAO_API=https://sirg.com.br
SIRG_CONCEICAO_ACESSO=https://sirg.com.br/login
SIRG_CONCEICAO_MUNICIPIO=CONCEICAO_DO_ALMEIDA
